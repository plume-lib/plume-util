# Package Files #
# ".gitignore" supports only whole-line comments, so the comment about
# gradle-wrapper.jar cannot appear at the end of the "*.jar" line.
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
# .jar file not to ignore
!gradle/wrapper/gradle-wrapper.jar

